{
  "name": "NeoFaro | Vecinos Cercanos",
  "short_name": "NeoFaro",
  "description": "Descubrí comercios, ofertas y servicios cerca tuyo en tu barrio sin vueltas.",
  "start_url": "/",
  "id": "/",
  "scope": "/",
  "dir": "ltr",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait-primary",
  "background_color": "#09090b",
  "theme_color": "#06b6d4",
  "lang": "es",
  "prefer_related_applications": false,
  "related_applications": [],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "serviceworker": {
    "src": "/sw.js",
    "scope": "/",
    "type": "classic"
  },
  "share_target": {
    "action": "/?source=share_target",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "categories": [
    "shopping",
    "food",
    "navigation",
    "business"
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Mapa y Ofertas",
      "short_name": "Mapa",
      "description": "Abrir el mapa satelital de comercios y ofertas en tu zona",
      "url": "/?source=pwa_shortcut",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Mi Comercio",
      "short_name": "Mi Local",
      "description": "Administrar mi local, catálogo y promociones",
      "url": "/mi-comercio?source=pwa_shortcut",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Sumar un Comercio",
      "short_name": "Registrar",
      "description": "Registrar un comercio en el mapa vecinal",
      "url": "/cargar-comercio?source=pwa_shortcut",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-mobile.png",
      "sizes": "720x1280",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Mapa satelital GPS con comercios y ofertas en tu barrio"
    },
    {
      "src": "/screenshot-desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Directorio barrial y catálogo interactivo de comercios"
    }
  ]
}
